{
  "entities": {
    "MenuItem": {
      "title": "Menu Item",
      "description": "An item offered on the restaurant menu",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "price": { "type": "number" },
        "category": { "type": "string" },
        "desc": { "type": "string" },
        "image": { "type": "string" },
        "available": { "type": "boolean" }
      },
      "required": ["name", "price", "category", "desc"]
    },
    "Order": {
      "title": "Order",
      "description": "A customer order from a table or bar seat",
      "type": "object",
      "properties": {
        "table": { "type": "string" },
        "items": { "type": "array" },
        "total": { "type": "number" },
        "status": { "type": "string", "enum": ["new", "preparing", "ready", "served", "cancelled"] },
        "userId": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["table", "items", "total", "status", "createdAt"]
    },
    "InventoryItem": {
      "title": "Inventory Item",
      "description": "Stock levels for critical restaurant supplies",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "currentAmount": { "type": "number" },
        "threshold": { "type": "number" },
        "unit": { "type": "string" }
      },
      "required": ["name", "currentAmount", "threshold", "unit"]
    }
  },
  "firestore": {
    "menu": {
      "schema": "MenuItem",
      "description": "The full food and drink catalog"
    },
    "orders": {
      "schema": "Order",
      "description": "All customer transactions and active service tickets"
    },
    "inventory": {
      "schema": "InventoryItem",
      "description": "Real-time stock tracking for the bar and kitchen"
    }
  }
}
