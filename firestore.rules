rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // 0. Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper Primitives
    function isSignedIn() { return request.auth != null; }
    function isValidId(id) { return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$'); }
    function isAdmin() { 
      return isSignedIn() && (
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) ||
        request.auth.token.email == 'lukeokagha@gmail.com'
      ); 
    }
    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }

    // 1. Menu Collection
    match /menu/{itemId} {
      allow read: if true;
      allow write: if isAdmin() && isValidMenuItem(incoming());
      
      function isValidMenuItem(data) {
        return data.name is string && data.name.size() > 0 && data.name.size() <= 100 &&
               data.price is number && data.price >= 0 &&
               data.category is string &&
               data.desc is string && data.desc.size() <= 500;
      }
    }

    // 2. Orders Collection
    match /orders/{orderId} {
      // Users can see their own orders, Admins see all
      allow list: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow get: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      
      allow create: if isSignedIn() && isValidOrder(incoming()) && incoming().userId == request.auth.uid;
      
      allow update: if isSignedIn() && (
        (isAdmin() && isStatusUpdate() && isValidOrder(incoming())) ||
        (existing().userId == request.auth.uid && isUserUpdate() && isValidOrder(incoming()))
      );

      function isValidOrder(data) {
        return data.table is string && data.table.size() <= 50 &&
               data.items is list && data.items.size() > 0 &&
               data.total is number && data.total >= 0 &&
               data.status in ['new', 'preparing', 'ready', 'served', 'cancelled'] &&
               data.userId == request.auth.uid &&
               data.createdAt == request.time;
      }

      function isStatusUpdate() {
        return incoming().diff(existing()).affectedKeys().hasOnly(['status', 'updatedAt']) &&
               incoming().updatedAt == request.time;
      }

      function isUserUpdate() {
        return existing().status == 'new' && 
               incoming().diff(existing()).affectedKeys().hasOnly(['items', 'total', 'updatedAt']) &&
               incoming().updatedAt == request.time;
      }
    }

    // 3. Inventory
    match /inventory/{itemId} {
      allow read, write: if isAdmin();
    }
    
    // 4. Admin Bootstrap
    match /admins/{adminId} {
      allow read: if isSignedIn() && (request.auth.uid == adminId || isAdmin());
      allow write: if false; // Only manageable via console
    }
  }
}
