rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // 0. Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper Primitives
    function isSignedIn() { return request.auth != null; }
    
    function isAdmin() { 
      return isSignedIn() && (
        get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.role == 'admin' ||
        request.auth.token.email == 'contact@tricodepro' ||
        request.auth.token.email == 'lukeokagha@gmail.com'
      ); 
    }

    function isStaff() {
      return isSignedIn() && (
        get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.role in ['admin', 'staff', 'staff_bar', 'staff_waiter']
      );
    }

    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }

    // 1. Menu Collection
    match /menu/{itemId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // 2. Orders Collection
    match /orders/{orderId} {
      // Users can see their own orders, Staff/Admins see relevant records
      allow list: if isSignedIn() && (
        resource.data.userId == request.auth.uid || 
        resource.data.staffId == request.auth.uid ||
        isAdmin()
      );
      
      allow get: if isSignedIn() && (
        resource.data.userId == request.auth.uid || 
        resource.data.staffId == request.auth.uid ||
        isAdmin()
      );
      
      allow create: if isSignedIn();
      
      allow update: if isSignedIn() && (
        isAdmin() || 
        isStaff() ||
        (existing().userId == request.auth.uid && existing().status == 'new')
      );
    }

    // 3. Inventory
    match /inventory/{itemId} {
      allow read: if isStaff();
      allow write: if isAdmin();
    }
    
    // 4. Personnel Management
    match /admins/{adminId} {
      allow read: if isSignedIn() && (request.auth.uid == adminId || isAdmin());
      allow write: if isAdmin();
    }
  }
}
