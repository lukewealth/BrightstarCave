rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // 0. Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper Primitives
    function isSignedIn() { return request.auth != null; }
    
    // Resilient Admin Check
    function isAdmin() { 
      return isSignedIn() && (
        request.auth.token.email == 'contact@tricodepro' ||
        request.auth.token.email == 'lukeokagha@gmail.com' ||
        (exists(/databases/$(database)/documents/admins/$(request.auth.uid)) && 
         get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.role == 'admin')
      ); 
    }

    function isStaff() {
      return isSignedIn() && (
        isAdmin() ||
        (exists(/databases/$(database)/documents/admins/$(request.auth.uid)) && 
         get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.role in ['admin', 'staff', 'staff_bar', 'staff_waiter'])
      );
    }

    // 1. Menu Collection
    match /menu/{itemId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // 2. Orders Collection
    match /orders/{orderId} {
      allow list: if isSignedIn() && (
        resource.data.userId == request.auth.uid || 
        resource.data.staffId == request.auth.uid ||
        isAdmin() || isStaff()
      );
      
      allow get: if isSignedIn() && (
        resource.data.userId == request.auth.uid || 
        resource.data.staffId == request.auth.uid ||
        isAdmin() || isStaff()
      );
      
      allow create: if isSignedIn();
      
      allow update: if isSignedIn() && (
        isAdmin() || 
        isStaff() ||
        (resource.data.userId == request.auth.uid && resource.data.status == 'new')
      );
      
      allow delete: if isAdmin();
    }

    // 3. Inventory
    match /inventory/{itemId} {
      allow read: if isStaff();
      allow write: if isAdmin();
    }
    
    // 4. Personnel Management (admins collection)
    match /admins/{adminId} {
      // Allow list for admins, or users searching for their own email role check
      allow list: if isAdmin() || (isSignedIn() && request.query.limit <= 1);
      
      // Allow get for own document or if admin
      allow get: if isSignedIn() && (request.auth.uid == adminId || isAdmin());
      
      // Allow write for admins to onboard/edit staff
      allow write: if isAdmin();
    }
  }
}
